# port
# 端口号
VITE_PORT = 3100

# spa-title
# 网站标题
VITE_GLOB_APP_TITLE = 高频订单可视化平台

# spa shortname
# 简称，用于配置文件名字 不要出现空格、数字开头等特殊字符
VITE_GLOB_APP_SHORT_NAME = vue_vben_admin

#解决bug
VITE_BUILD_COMPRESS=gzip

# Whether to open mock
# 是否开启mock数据，关闭时需要自行对接后台接口
VITE_USE_MOCK = true

# public path
# 资源公共路径,需要以 / 开头和结尾
VITE_PUBLIC_PATH = /

# 生产环境不使用代理，直接配置实际后端地址
# VITE_PROXY = []

# Delete console
# 是否删除Console.log
VITE_DROP_CONSOLE = true

# Basic interface address SPA
# 生产环境直接配置后端地址，避免跨域问题
VITE_GLOB_API_URL=http://10.1.228.10:18080/basic-api

# File upload address， optional
# 文件上传接口，生产环境直接配置实际地址
VITE_GLOB_UPLOAD_URL=http://10.1.228.10:18080/upload

# Interface prefix
# 接口地址前缀，有些系统所有接口地址都有前缀，可以在这里统一加，方便切换
VITE_GLOB_API_URL_PREFIX=
